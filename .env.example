# ---- copy to .env (never commit it) ----

# Port the server listens on.
PORT=3000

# SQLite file. Put it on a persistent volume in production (the Docker image uses /data/app.db).
DATABASE_PATH=./data/app.db

# --- study -------------------------------------------------------------------
# true  = consent screen, tasks, event logging, questionnaire, balanced assignment to conditions.
# false = a plain product: no consent, nothing is logged, saved designs still work.
STUDY_MODE=true
# Conditions participants are balanced across. "manual" has no AI features, "ai" has the assistant and photo analysis.
CONDITIONS=manual,ai
# Lets a URL like /?condition=manual&pid=ABC force a condition and carry an external participant ID.
# Turn on for piloting, turn OFF for the real study so nobody can choose their own arm.
ALLOW_CONDITION_OVERRIDE=false
# Path to the tasks / consent / questionnaire file.
STUDY_CONFIG=./study.config.json

# --- Claude ------------------------------------------------------------------
# Without a key the AI assistant and photo analysis are switched off and everything else works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Hard cap on AI calls per participant session (chat messages + photo analyses). Controls your spend.
AI_CALLS_PER_SESSION=60
# Keep uploaded inspiration photos on disk. Default false: only the text analysis is kept.
STORE_IMAGES=false
MAX_IMAGE_MB=5

# --- admin -------------------------------------------------------------------
# The /admin dashboard and CSV exports exist only if ADMIN_PASSWORD is set. Use a long random value.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- hosting -----------------------------------------------------------------
# Number of reverse-proxy hops in front of the app (Render, Fly, Railway, nginx: 1). Needed for correct per-IP rate limits.
TRUST_PROXY=
# Shown in the page footer.
SITE_DISCLAIMER=Kohler research prototype. Prices are those in the study catalogue.
LOG_REQUESTS=true
